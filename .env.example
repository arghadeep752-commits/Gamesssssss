# Client build-time overrides (optional; defaults come from assets/config/hime.json).
# Only PUBLIC values belong here — never the service-role / secret key.
HIME_SUPABASE_URL=https://your-project.supabase.co
HIME_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# HIME_FIREBASE_JSON={"apiKey":"...","appId":"...","messagingSenderId":"...","projectId":"..."}

# Edge-function secrets (set with `supabase secrets set`, never shipped in the app):
# FCM_SERVICE_ACCOUNT=<service account JSON>
# CLOUDFLARE_TURN_KEY_ID=...
# CLOUDFLARE_TURN_API_TOKEN=...
# METERED_TURN_APP=...
# METERED_TURN_API_KEY=...
# TURN_URLS=turns:turn.example.com:5349,turn:turn.example.com:3478
# TURN_USERNAME=...
# TURN_CREDENTIAL=...
