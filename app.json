{
  "expo": {
    "name": "Camero Plus",
    "slug": "camero-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "android": {
      "package": "com.cameroplus.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Camero Plus shows the photos and videos you take in its gallery.",
          "savePhotosPermission": "Camero Plus saves your photos and videos to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo", "video"]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter-Regular.otf",
            "./assets/fonts/Inter-Medium.otf",
            "./assets/fonts/Inter-SemiBold.otf",
            "./assets/fonts/InterDisplay-Medium.otf",
            "./assets/fonts/InterDisplay-SemiBold.otf"
          ]
        }
      ],
      "./plugins/withCameroAndroid"
    ]
  }
}
