# Non-secret deployment settings for the DevDarshan Cloud Functions.
# The deploy workflow overwrites the two region values with the locations it
# detects for your Firestore database and Storage bucket.

# The only Google account allowed to claim the first admin role (once), stored as
# the SHA-256 of its lower-case email so the address is not published in this
# public repository. To change it:  printf '%s' 'name@gmail.com' | sha256sum
# (A plain DEVDARSHAN_ADMIN_BOOTSTRAP_EMAIL=... line also works, for private repos.)
DEVDARSHAN_ADMIN_BOOTSTRAP_EMAIL_SHA256=4d928e0ee7a90f825d2a4fbe418e03c52651c02f56b0b65c88024ac1d8ab342c

# Firestore-triggered functions must run in the database's region.
DEVDARSHAN_FIRESTORE_REGION=asia-south1

# Storage-triggered functions must run in the bucket's region.
DEVDARSHAN_STORAGE_REGION=us-central1

# Turn on once the apps are distributed through Google Play (Play Integrity
# rejects sideloaded installs, so enforcing earlier would block them).
DEVDARSHAN_ENFORCE_APP_CHECK=false
