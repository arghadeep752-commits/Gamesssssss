{
  "name": "devdarshan-functions",
  "version": "1.0.0",
  "private": true,
  "description": "DevDarshan Cloud Functions: image processing, search keywords, counters, admin roles, safe deletes and cleanup.",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-shared": "node scripts/sync-shared.mjs",
    "build": "npm run sync-shared && tsc -p tsconfig.json",
    "typecheck": "npm run sync-shared && tsc --noEmit -p tsconfig.json",
    "test": "npm run sync-shared && vitest run"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "firebase-functions": "^7.0.0",
    "sharp": "^0.35.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
