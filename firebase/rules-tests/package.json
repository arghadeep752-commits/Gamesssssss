{
  "name": "devdarshan-rules-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Security rules tests. Run with: npm test (starts the Firestore + Storage emulators).",
  "scripts": {
    "test": "firebase emulators:exec --config ../firebase.json --only firestore,storage --project demo-devdarshan \"vitest run\"",
    "test:only": "vitest run"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0",
    "vitest": "^3.2.4"
  }
}
