{
  "name": "arrow-flow",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "node --import tsx --test test/*.test.ts",
    "levels:build": "tsx scripts/build-levels.ts",
    "levels:validate": "tsx scripts/validate-levels.ts",
    "sounds": "python3 scripts/make-sounds.py",
    "icons": "node scripts/make-icons.mjs",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "verify": "npm run typecheck && npm test && npm run levels:validate"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-haptics": "~57.0.3",
    "expo-navigation-bar": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo-asset": "~57.0.20"
  }
}
