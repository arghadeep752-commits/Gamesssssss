; Engine configuration file.
; NINJA: SHADOW LEGACY - MXYAN GAMES

config_version=5

[application]

config/name="Ninja: Shadow Legacy"
config/description="2D action platformer by MXYAN GAMES"
config/version="1.0.0"
run/main_scene="res://scenes/splash/splash.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
config/quit_on_go_back=false

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Events="*res://scripts/core/events.gd"
GameData="*res://scripts/core/game_data.gd"
SaveManager="*res://scripts/save/save_manager.gd"
AudioManager="*res://scripts/audio/audio_manager.gd"
UITheme="*res://scripts/ui/ui_theme.gd"
SpriteLib="*res://scripts/core/sprite_lib.gd"
Pool="*res://scripts/core/pool.gd"
Haptics="*res://scripts/core/haptics.gd"
SceneManager="*res://scripts/core/scene_manager.gd"

[debug]

gdscript/warnings/unused_parameter=0
gdscript/warnings/unused_variable=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/unused_signal=0
gdscript/warnings/return_value_discarded=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_attack"
2d_physics/layer_5="enemy_attack"
2d_physics/layer_6="pickups"
2d_physics/layer_7="hazards"
2d_physics/layer_8="one_way"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=2200.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.05, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=false
anti_aliasing/quality/msaa_2d=0
