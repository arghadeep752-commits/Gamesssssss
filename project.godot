; Engine configuration file.
; Scary Aunty - a simple first person escape horror game.

config_version=5

[application]

config/name="Scary Aunty"
config/description="Scary Aunty kidnapped you. Escape from her 3 floor house!"
config/version="0.1"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Global="*res://scripts/global.gd"
Assets="*res://scripts/assets.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
scaling_3d/scale=0.85
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
reflections/reflection_atlas/reflection_size=256
reflections/reflection_atlas/reflection_count=32
environment/defaults/default_clear_color=Color(0, 0, 0, 1)

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true,
"process/size_limit": 1024
}
